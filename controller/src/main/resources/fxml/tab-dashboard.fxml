<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desktoppet.ui.DashboardTabController"
      spacing="12">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <!-- Connection Status -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="连接状态" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="○ 未连接" styleClass="status-disconnected"/>
        <Button fx:id="restartButton" text="重启渲染器" onAction="#onRestartRenderer"/>
    </HBox>
    <Separator/>

    <!-- Current Model -->
    <VBox spacing="5">
        <Label text="当前模型" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="modelComboBox" prefWidth="200" onAction="#onModelSelected"/>
            <Button text="刷新" onAction="#onRefreshModels"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- Model Info -->
    <VBox spacing="3">
        <Label text="模型信息" styleClass="section-title"/>
        <Label fx:id="motionGroupsLabel" text="动作组: —" styleClass="info-text"/>
        <Label fx:id="expressionsLabel" text="表情: —" styleClass="info-text"/>
        <Label fx:id="hitAreasLabel" text="Hit区域: —" styleClass="info-text"/>
    </VBox>
    <Separator/>

    <!-- Runtime Status -->
    <VBox spacing="3">
        <Label text="运行状态" styleClass="section-title"/>
        <Label fx:id="windowPositionLabel" text="窗口位置: —" styleClass="info-text"/>
        <Label fx:id="opacityLabel" text="透明度: —" styleClass="info-text"/>
        <Label fx:id="idleIntervalLabel" text="闲时动作: —" styleClass="info-text"/>
        <Label fx:id="schedulerStatusLabel" text="调度器: —" styleClass="info-text"/>
    </VBox>
    <Separator/>

    <!-- Activity Log -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="最近活动" styleClass="section-title"/>
        <ListView fx:id="activityLog" prefHeight="120" VBox.vgrow="ALWAYS" styleClass="activity-log"/>
    </VBox>
</VBox>
