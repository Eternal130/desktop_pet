<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desktoppet.ui.SettingsTabController"
      spacing="12">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <!-- Appearance -->
    <VBox spacing="5">
        <Label text="外观" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="窗口透明度" prefWidth="80"/>
            <Slider fx:id="opacitySlider" min="0.1" max="1.0" value="1.0"
                    showTickLabels="true" showTickMarks="true"
                    majorTickUnit="0.25" prefWidth="200"/>
            <Label fx:id="opacityValueLabel" text="1.00"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- Behavior -->
    <VBox spacing="8">
        <Label text="行为" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="拖拽模式" prefWidth="80"/>
            <RadioButton fx:id="directModeRadio" text="直接跟随" userData="direct"/>
            <RadioButton fx:id="physicsModeRadio" text="物理模式(预留)" userData="physics"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="闲时间隔" prefWidth="80"/>
            <Spinner fx:id="idleIntervalSpinner" prefWidth="80" editable="true"/>
            <Label text="秒"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="渲染帧率" prefWidth="80"/>
            <RadioButton fx:id="adaptiveFpsRadio" text="自适应" userData="adaptive"/>
            <RadioButton fx:id="fixedFpsRadio" text="指定帧率" userData="fixed"/>
            <Spinner fx:id="fpsSpinner" prefWidth="80" editable="true"/>
            <Label text="FPS"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- Voice Pack -->
    <VBox spacing="8">
        <Label text="语音包" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="挂载语音包" prefWidth="80"/>
            <ComboBox fx:id="voicePackComboBox" prefWidth="200" onAction="#onVoicePackChanged"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- Hit Action Mapping -->
    <VBox spacing="5">
        <Label text="点击交互映射" styleClass="section-title"/>
        <TableView fx:id="hitMappingTable" prefHeight="100" editable="true">
            <columns>
                <TableColumn fx:id="hitAreaColumn" text="命中区域" prefWidth="100" editable="false"/>
                <TableColumn fx:id="motionGroupColumn" text="动作组" prefWidth="150"/>
                <TableColumn fx:id="priorityColumn" text="优先级" prefWidth="80"/>
            </columns>
        </TableView>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="恢复默认映射" onAction="#onResetMappings" styleClass="button-secondary"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- System -->
    <VBox spacing="5">
        <Label text="系统" styleClass="section-title"/>
        <CheckBox fx:id="autoStartCheckBox" text="开机自启"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="恢复默认设置" onAction="#onResetAll" styleClass="button-secondary"/>
        <Button text="保存" onAction="#onSave" styleClass="button-primary"/>
    </HBox>
</VBox>
