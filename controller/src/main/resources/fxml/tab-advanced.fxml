<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desktoppet.ui.AdvancedTabController"
      spacing="12">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <!-- Renderer Management -->
    <VBox spacing="5">
        <Label text="渲染器管理" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="rendererStatusLabel" text="状态: 未知" styleClass="info-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="重启" onAction="#onRestartRenderer" styleClass="button-primary"/>
            <Button text="停止" onAction="#onStopRenderer" styleClass="button-secondary"/>
        </HBox>
        <Label fx:id="restartAttemptsLabel" text="崩溃恢复: —" styleClass="info-text"/>
    </VBox>
    <Separator/>

    <!-- Window Position -->
    <VBox spacing="5">
        <Label text="窗口位置" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="X:"/>
            <Spinner fx:id="positionXSpinner" prefWidth="100" editable="true"/>
            <Label text="Y:"/>
            <Spinner fx:id="positionYSpinner" prefWidth="100" editable="true"/>
            <Button text="应用" onAction="#onApplyPosition" styleClass="button-primary"/>
        </HBox>
    </VBox>
    <Separator/>

    <!-- Message Debug Log -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="通信调试" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="autoScrollCheckBox" text="自动滚动" selected="true"/>
            <Button text="清空" onAction="#onClearLog" styleClass="button-secondary"/>
        </HBox>
        <ListView fx:id="messageLogView" prefHeight="180" VBox.vgrow="ALWAYS" styleClass="message-log"/>
    </VBox>
    <Separator/>

    <!-- Config Management -->
    <VBox spacing="5">
        <Label text="配置文件" styleClass="section-title"/>
        <Label fx:id="configPathLabel" text="路径: —" styleClass="hint-text"/>
        <HBox spacing="10">
            <Button text="打开配置目录" onAction="#onOpenConfigDir" styleClass="button-secondary"/>
            <Button text="重载配置" onAction="#onReloadConfig" styleClass="button-secondary"/>
        </HBox>
    </VBox>
</VBox>
