<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desktoppet.ui.MainWindowController"
      prefWidth="1200"
      prefHeight="760"
      styleClass="root">

    <HBox fx:id="titleBar" styleClass="title-bar" alignment="CENTER_LEFT" spacing="12"
          onMousePressed="#onTitleBarPressed" onMouseDragged="#onTitleBarDragged">
        <padding><Insets top="0" right="8" bottom="0" left="16"/></padding>
        <Label text="Live2D 桌面宠物控制面板 ✧" styleClass="title-bar-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="themeCombo" styleClass="theme-combo" onAction="#onThemeChanged" prefWidth="120"/>
        <Button text="—" styleClass="title-btn" onAction="#onMinimize"/>
        <Button text="✕" styleClass="title-btn title-btn-close" onAction="#onCloseWindow"/>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <VBox prefWidth="260" minWidth="260" maxWidth="260" spacing="12" styleClass="sidebar">
            <Label text="Live2D Console ✧" styleClass="sidebar-title"/>
            <Separator/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane">
                <VBox fx:id="instanceListBox" spacing="12">
                    <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                </VBox>
                <VBox.vgrow><Priority fx:constant="ALWAYS"/></VBox.vgrow>
            </ScrollPane>
            <Button fx:id="addInstanceBtn" text="＋ 添加实例" styleClass="btn-add-instance"
                    onAction="#onAddInstance" maxWidth="1.7976931348623157E308"/>
        </VBox>

        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="scroll-pane" HBox.hgrow="ALWAYS">
            <VBox fx:id="mainContent" spacing="20" styleClass="main-content">
                <padding><Insets top="24" right="32" bottom="24" left="28"/></padding>

                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="detail-header">
                    <Label fx:id="modelNameBig" text="Hiyori" styleClass="main-model-name"/>
                    <Label fx:id="instanceTagLabel" text="✎ 主屏宠物" styleClass="main-tag" onMouseClicked="#onEditTag"/>
                    <Label fx:id="connectionBadge" text="● 已连接" styleClass="connection-badge-connected"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="toggleStatusBtn" text="停止运行" styleClass="btn-danger-outline" onAction="#onToggleStatus"/>
                    <Button text="重启引擎 ↺" styleClass="btn-primary" onAction="#onRestartEngine"/>
                </HBox>

                <HBox spacing="24">
                    <padding><Insets top="8"/></padding>
                    <VBox styleClass="model-card" prefWidth="260" minWidth="260" maxWidth="260" spacing="12" alignment="CENTER">
                        <Label fx:id="avatarLabel" text="H" styleClass="avatar-circle"/>
                        <Label fx:id="modelNameCard" text="Hiyori" styleClass="card-model-name"/>
                        <ComboBox fx:id="modelSelectCombo" styleClass="model-select" maxWidth="1.7976931348623157E308" onAction="#onModelChanged"/>
                        <Label fx:id="statsLabel" text="4 动作组 · 4 表情 · 2 触控区" styleClass="stats-row"/>
                        <Label text="语音包" styleClass="setting-label"/>
                        <ComboBox fx:id="voicePackCombo" styleClass="model-select" maxWidth="1.7976931348623157E308" onAction="#onVoicePackChanged"/>
                    </VBox>

                    <VBox spacing="20" HBox.hgrow="ALWAYS">
                        <VBox spacing="10">
                            <Label text="✦ 快捷动作触发" styleClass="section-title"/>
                            <GridPane fx:id="motionGrid" hgap="12" vgap="12"/>
                        </VBox>
                        <VBox spacing="10">
                            <Label fx:id="expressionTitle" text="✦ 表情控制 当前: F01" styleClass="section-title"/>
                            <HBox fx:id="expressionRow" spacing="10" styleClass="expression-row"/>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox spacing="12" styleClass="settings-panel">
                    <HBox spacing="32" alignment="CENTER_LEFT">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="窗口透明度" styleClass="setting-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Slider fx:id="opacitySlider" min="0.1" max="1.0" value="1.0"
                                        blockIncrement="0.1" HBox.hgrow="ALWAYS" minWidth="100"/>
                                <Label fx:id="opacityValueLabel" text="1.0" styleClass="value-display" minWidth="36"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="拖拽模式" styleClass="setting-label"/>
                            <HBox spacing="0" styleClass="seg-control">
                                <Button fx:id="dragDirectBtn" text="直接" styleClass="seg-btn" onAction="#onDragDirect"/>
                                <Button fx:id="dragPhysicsBtn" text="物理" styleClass="seg-btn" onAction="#onDragPhysics"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="闲置间隔" styleClass="setting-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Slider fx:id="idleSlider" min="1" max="60" value="10"
                                        blockIncrement="5" HBox.hgrow="ALWAYS" minWidth="80"/>
                                <Label fx:id="idleValueLabel" text="10s" styleClass="value-display" minWidth="36"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="语音音量" styleClass="setting-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Slider fx:id="volumeSlider" min="0.0" max="1.0" value="1.0"
                                        blockIncrement="0.1" HBox.hgrow="ALWAYS" minWidth="100"/>
                                <Label fx:id="volumeValueLabel" text="100%" styleClass="value-display" minWidth="36"/>
                            </HBox>
                        </VBox>
                     </HBox>

                    <HBox spacing="32" alignment="CENTER_LEFT">
                        <VBox spacing="8">
                            <Label text="渲染帧率" styleClass="setting-label"/>
                            <HBox spacing="0" styleClass="seg-control">
                                <Button fx:id="fpsAdaptiveBtn" text="自适应" styleClass="seg-btn" onAction="#onFpsAdaptive"/>
                                <Button fx:id="fpsFixedBtn" text="指定" styleClass="seg-btn" onAction="#onFpsFixed"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="目标帧率" styleClass="setting-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Slider fx:id="fpsSlider" min="15" max="120" value="30"
                                        blockIncrement="15" HBox.hgrow="ALWAYS" minWidth="80"/>
                                <Label fx:id="fpsValueLabel" text="30" styleClass="value-display" minWidth="36"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="32" alignment="CENTER_LEFT">
                        <VBox spacing="8">
                            <Label text="坐标 (X, Y)" styleClass="setting-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <TextField fx:id="posXField" text="1200" styleClass="coord-input" prefWidth="70"/>
                                <TextField fx:id="posYField" text="600" styleClass="coord-input" prefWidth="70"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="开机自启" styleClass="setting-label"/>
                            <CheckBox fx:id="autoStartCheck" styleClass="toggle-switch"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="log-panel" VBox.vgrow="ALWAYS" minHeight="150">
                    <HBox alignment="CENTER_LEFT" styleClass="log-header">
                        <Label text="活动日志 ✦" styleClass="log-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="清空" styleClass="btn-clear" onAction="#onClearLog"/>
                    </HBox>
                    <ListView fx:id="logListView" styleClass="log-content" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
